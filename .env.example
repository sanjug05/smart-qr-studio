# This file documents the build-time variables the frontend reads. The
# first two are plain config, not secrets; the third behaves like one and
# must be handled that way — see backend/.dev.vars.example for the
# separately-deployed Dynamic QR API's own configuration.

# Base path the app is served from. Required when deploying to a GitHub Pages
# *project* site (https://<user>.github.io/<repo>/) so asset URLs resolve
# correctly. Leave unset (defaults to "/") for a custom domain or a GitHub
# Pages *user/org* site (https://<user>.github.io/).
VITE_BASE_PATH=/smart-qr-studio/

# The Dynamic QR API's origin — the Firebase Cloud Function (see backend/, and
# README → "Dynamic QR architecture"). Required for any build that will
# create/resolve/edit Dynamic QR codes; there is NO built-in default, so a
# build without it fails closed. A production build also refuses anything
# that is not a public https URL (no localhost / 127.0.0.1 / 0.0.0.0). For
# local development, put the Functions-emulator URL in `.env.local`
# (gitignored), e.g.:
#   VITE_DYNAMIC_QR_API_BASE_URL=http://127.0.0.1:5001/<project-id>/us-central1/api
# VITE_DYNAMIC_QR_API_BASE_URL=

# The plan every visitor runs as: free | pro | business. The product currently
# operates at Business level, so the GitHub Pages workflow sets this to
# "business" (Dynamic QR available, no Pro badge). Unset or unrecognized, a
# production build falls back to "free" (Dynamic QR locked) and a dev server
# to "pro". Keep it in step with DEFAULT_PLAN in backend/src/config.ts — the
# backend enforces the same rule independently. Not a secret.
# VITE_DEFAULT_PLAN=business

# In GitHub Pages builds the API origin above comes from the repository
# *variable* DYNAMIC_QR_API_BASE_URL (Settings > Secrets and variables >
# Actions > Variables) — a public URL, so a variable rather than a secret.
# Unset, Dynamic QR fails closed; localhost or non-https values are refused.

# Optional, and NOT for normal builds — leave unset for every real
# development/staging/production build. Only set this for a deliberately
# separate, one-off build used to test Dynamic QR end-to-end against a
# production-configured backend without enabling the feature for real
# production users. Baked in at build time only (never a query string,
# never localStorage) — see src/services/dynamicQr/config.ts. Has no effect
# by itself: the backend independently requires its own matching secret
# (`DYNAMIC_QR_TEST_OVERRIDE_SECRET`, never committed) before it grants
# anything — see backend/src/lib/entitlements.ts.
# VITE_DYNAMIC_QR_TEST_OVERRIDE_SECRET=

# ---------------------------------------------------------------------------
# sanjugupta.com/qr deployment settings (all public, none is a secret)
# ---------------------------------------------------------------------------
# Sub-path the app is served from, and the service-worker/manifest scope.
# The host redirects /qr/ to /qr, so the PWA scope has no trailing slash.
# VITE_BASE_PATH=/qr/
# VITE_PWA_SCOPE=/qr

# The canonical origin every QR link is built on (see src/services/appUrl.ts).
# Unset, links use the current origin + base path (right for local dev).
# VITE_PUBLIC_BASE_URL=https://sanjugupta.com/qr/

# Firebase web app config, from `firebase apps:sdkconfig web`. These are public
# client identifiers (protected by Firestore rules + Auth authorized domains).
# Any one missing => sign-in / cloud library are simply unavailable.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=smart-qr-studio-app.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=smart-qr-studio-app
# VITE_FIREBASE_APP_ID=
#
# For a local production-like build, put the real values in .env.production.local
# (git-ignored). In CI they come from repository variables.
