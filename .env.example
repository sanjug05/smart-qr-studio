# Smart QR Studio has no backend in V1 — there are no secrets to configure.
# This file documents the one build-time variable the app reads.

# Base path the app is served from. Required when deploying to a GitHub Pages
# *project* site (https://<user>.github.io/<repo>/) so asset URLs resolve
# correctly. Leave unset (defaults to "/") for a custom domain or a GitHub
# Pages *user/org* site (https://<user>.github.io/).
VITE_BASE_PATH=/smart-qr-studio/
